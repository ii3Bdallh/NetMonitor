[Unit]
Description=Network Usage Monitor Daemon (NetMonitor)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/usr/local/bin/netmon --daemon
Restart=always
RestartSec=10
User=root

# Security sandboxing
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/netmon

[Install]
WantedBy=multi-user.target
